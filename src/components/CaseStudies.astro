---
import CaseStudiesSlider from './CaseStudiesSlider';

interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow = 'Resultados', title } = Astro.props;
---

<section id="casos-de-exito" class="reveal">
  <CaseStudiesSlider client:load eyebrow={eyebrow} title={title} />
</section>
