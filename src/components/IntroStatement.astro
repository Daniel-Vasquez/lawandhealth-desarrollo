---
interface Props {
  title: string;
  paragraph: string;
}

const { title, paragraph } = Astro.props;
---

<section
  class="js-intro-statement reveal relative min-h-screen h-screen w-full overflow-hidden"
>
  <!-- Background video -->
  <video
    class="js-intro-video absolute inset-0 w-full h-full object-cover object-right md:object-center"
    src="videos/Intro-statement-video.webm"
    muted
    loop
    playsinline
    preload="metadata"
  >
  </video>

  <!-- Contrast overlay -->
  <div class="absolute inset-0 bg-brand-primary/70"></div>

  <!-- Content -->
  <div class="relative z-10 h-full flex items-end">
    <div
      class="max-w-4xl m-6 md:m-10 px-6 py-8 md:px-8 md:py-10 text-start bg-brand-primary/40"
      style="backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);"
    >
      <div class="w-16 h-[2px] bg-brand-secondary mb-8"></div>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter text-white leading-tight mb-6"
      >
        {title}
      </h2>
      <p class="text-base md:text-lg text-white/70 leading-relaxed">
        {paragraph}
      </p>
    </div>
  </div>

  <!-- Play / pause control -->
  <div
    class="absolute top-4 right-4 md:top-9 md:right-9 z-10 flex items-center gap-3"
  >
    <span
      class="js-intro-video-hint text-xs font-bold uppercase tracking-widest text-white bg-brand-primary/60 px-3 py-1.5 rounded-full whitespace-nowrap"
      style="backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);"
    >
      Ver video
    </span>

    <button
      type="button"
      class="js-intro-video-toggle relative flex items-center justify-center w-14 h-14 rounded-full bg-white/90 text-brand-primary shadow-lg hover:bg-white hover:scale-105 transition-all duration-200"
      aria-label="Reproducir video"
      aria-pressed="false"
    >
      <span
        class="js-intro-video-ping absolute inset-0 rounded-full bg-brand-secondary/70 animate-ping"
      ></span>
      <svg
        class="js-intro-video-icon-play relative w-5 h-5 translate-x-0.5"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg
        class="js-intro-video-icon-pause relative w-5 h-5 hidden"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  const initIntroStatement = () => {
    const section = document.querySelector<HTMLElement>(".js-intro-statement");
    const video = section?.querySelector<HTMLVideoElement>(".js-intro-video");
    const toggle = section?.querySelector<HTMLButtonElement>(
      ".js-intro-video-toggle",
    );
    const playIcon = section?.querySelector<SVGElement>(
      ".js-intro-video-icon-play",
    );
    const pauseIcon = section?.querySelector<SVGElement>(
      ".js-intro-video-icon-pause",
    );
    const hint = section?.querySelector<HTMLElement>(".js-intro-video-hint");
    const ping = section?.querySelector<HTMLElement>(".js-intro-video-ping");
    if (!video || !toggle || !playIcon || !pauseIcon || !hint || !ping) return;

    const setPlayingUI = (isPlaying: boolean) => {
      playIcon.classList.toggle("hidden", isPlaying);
      pauseIcon.classList.toggle("hidden", !isPlaying);
      hint.classList.toggle("hidden", isPlaying);
      ping.classList.toggle("hidden", isPlaying);
      toggle.setAttribute("aria-pressed", String(isPlaying));
      toggle.setAttribute(
        "aria-label",
        isPlaying ? "Pausar video" : "Reproducir video",
      );
    };

    toggle.addEventListener("click", () => {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    });

    video.addEventListener("play", () => setPlayingUI(true));
    video.addEventListener("pause", () => setPlayingUI(false));
  };

  initIntroStatement();
  document.addEventListener("astro:page-load", initIntroStatement);
</script>
