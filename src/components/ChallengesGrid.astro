---
interface Challenge {
  title: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  challenges: Challenge[];
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow = 'Diagnóstico', title, challenges, ctaLabel, ctaHref } = Astro.props;
---

<section id="desafios" class="reveal bg-brand-primary py-20 md:py-28">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-12 md:mb-16 max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-3">{eyebrow}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter text-white leading-tight">
        {title}
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/5">
      {
        challenges.map((challenge) => (
          <div class="group bg-brand-primary p-6 md:p-7 flex flex-col gap-4 hover:bg-brand-primary-light/10 transition-colors duration-300">
            <svg
              class="w-8 h-8 text-brand-secondary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
              />
            </svg>
            <p class="text-sm md:text-base font-bold text-white leading-snug">
              {challenge.title}
            </p>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-12 md:mt-16 text-center">
      <a
        href={ctaHref}
        class="group inline-flex items-center gap-3 bg-brand-secondary text-black font-black uppercase text-sm tracking-widest px-8 py-4 hover:bg-white transition-colors duration-200"
      >
        {ctaLabel}
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="3"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
