---
interface Tile {
  id: string;
  title: string;
  subtitle: string;
  image: string;
  href: string;
  accentColor?: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;
---

<section id="on-track" class="grid grid-cols-1 md:grid-cols-2 min-h-[70vh]">
  {
    tiles.map((tile) => (
      <a
        href={tile.href}
        class="js-track-tile group relative overflow-hidden min-h-[50vh] md:min-h-[70vh] flex items-end"
      >
        <!-- Background image -->
        <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105">
          <img
            src={tile.image}
            alt={tile.title}
            class="js-track-image w-full h-full object-cover object-center origin-center"
            loading="lazy"
          />
        </div>

        <!-- Dark overlay -->
        <div class="js-track-overlay absolute inset-0 bg-gradient-to-t from-brand-primary/90 via-brand-primary/30 to-transparent transition-opacity duration-300 group-hover:from-brand-primary/70" />

        <!-- Content -->
        <div class="relative z-10 p-8 md:p-12 w-full">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-2 opacity-0 -translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
            {tile.subtitle}
          </p>
          <div class="flex items-end justify-between">
            <h2 class="js-track-text text-4xl md:text-5xl lg:text-6xl font-black uppercase leading-none tracking-tighter text-white">
              {tile.title}
            </h2>
            <div class="js-track-text flex-shrink-0 w-12 h-12 border border-white/30 flex items-center justify-center transition-colors duration-300 group-hover:bg-brand-secondary group-hover:border-brand-secondary ml-4">
              <svg
                class="w-5 h-5 text-white transition-colors duration-300 group-hover:text-black"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Divider line on hover -->
        <div
          class="absolute top-0 bottom-0 left-0 w-1 bg-brand-secondary scale-y-0 origin-bottom transition-transform duration-500 group-hover:scale-y-100"
        />
      </a>
    ))
  }
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const tiles = document.querySelectorAll('.js-track-tile');

    tiles.forEach((tile) => {
      const image = tile.querySelector('.js-track-image');
      const overlay = tile.querySelector('.js-track-overlay');
      const texts = tile.querySelectorAll('.js-track-text');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: tile,
          start: 'top 85%',
          // "play reverse play reverse" asegura que:
          // 1. Inicie al scrollear hacia abajo y entrar en pantalla (play)
          // 2. Se revierta si sale de la pantalla por arriba (reverse)
          // 3. Se vuelva a iniciar si el usuario regresa haciendo scroll hacia arriba (play)
          // 4. Se revierta si el usuario regresa hacia arriba y sale de pantalla (reverse)
          toggleActions: 'play reverse play reverse',
        }
      });

      // Animación de aparición del contenedor principal (Tile)
      tl.fromTo(tile,
        { y: 80, opacity: 0 },
        { y: 0, opacity: 1, duration: 1, ease: 'power3.out' }
      )
      // Animación de escala de la imagen
      .fromTo(image,
        { scale: 1.3 },
        { scale: 1, duration: 1.4, ease: 'power3.out' },
        '<0.1' // Comienza casi al mismo tiempo que la animación anterior
      )
      // Animación de la capa oscura
      .fromTo(overlay,
        { opacity: 0 },
        { opacity: 1, duration: 1, ease: 'power2.out' },
        '<0.2'
      )
      // Animación de aparición de textos e ícono
      .fromTo(texts,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out' },
        '<0.3'
      );
    });
  };

  // Ejecutar al montar el componente
  initAnimations();
  
  // Re-ejecutar si se usa el router de Astro (View Transitions)
  document.addEventListener('astro:page-load', initAnimations);
</script>
