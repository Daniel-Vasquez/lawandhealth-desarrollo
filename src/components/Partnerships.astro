---
interface Partner {
  name: string;
  logo?: string;
  category?: string;
}

interface Props {
  partners: Partner[];
  theme?: 'dark' | 'light';
}

const { partners, theme = 'dark' } = Astro.props;
const isLight = theme === 'light';

const sectionBg = isLight ? 'bg-white' : 'bg-brand-primary-light/10';
const eyebrowText = isLight ? 'text-brand-primary-light' : 'text-brand-secondary';
const headingText = isLight ? 'text-brand-primary' : 'text-white';
const subText = isLight ? 'text-brand-primary/50' : 'text-white/40';
const gridBg = isLight ? 'bg-black/5' : 'bg-white/5';
const cardBg = isLight ? 'bg-white' : 'bg-brand-primary';
const cardHoverBg = isLight ? 'hover:bg-black/5' : 'hover:bg-white/5';
const logoFilter = isLight ? 'filter brightness-0' : 'filter brightness-0 invert';
const fallbackText = isLight
  ? 'text-brand-primary/30 group-hover:text-brand-primary/70'
  : 'text-white/30 group-hover:text-white/70';
---

<section id="clientes" class={`reveal ${sectionBg} py-20 md:py-28`}>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-14 md:mb-20 text-center">
      <p class={`text-xs font-bold uppercase tracking-[0.3em] ${eyebrowText} mb-3`}>Confianza</p>
      <h2 class={`text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter ${headingText} leading-none`}>
        Empresas que han confiado en Law &amp; Health
      </h2>
      <p class={`${subText} text-sm mt-4`}>Logotipos pendientes de autorización por parte de cada cliente.</p>
    </div>

    <!-- Partners grid -->
    <div class={`grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-px ${gridBg}`}>
      {
        partners.map((partner) => (
          <div class={`group ${cardBg} p-8 md:p-10 flex items-center justify-center aspect-[3/2] ${cardHoverBg} transition-colors duration-300`}>
            {partner.logo ? (
              <img
                src={partner.logo}
                alt={partner.name}
                class={`max-h-10 max-w-full object-contain ${logoFilter} opacity-50 group-hover:opacity-100 transition-opacity duration-300`}
                loading="lazy"
              />
            ) : (
              <span class={`${fallbackText} text-sm font-bold uppercase tracking-wider text-center transition-colors duration-300`}>
                {partner.name}
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
