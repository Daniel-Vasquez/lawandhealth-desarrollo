---
interface Step {
  title: string;
  description: string;
  image?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  steps: Step[];
  theme?: 'dark' | 'light';
}

const { eyebrow = 'Metodología', title, steps, theme = 'dark' } = Astro.props;
const isLight = theme === 'light';
const hasAnyImage = steps.some((s) => s.image);

const sectionBg = isLight ? 'bg-white' : 'bg-brand-primary-light/10';
const eyebrowText = isLight ? 'text-brand-primary-light' : 'text-brand-secondary';
const headingText = isLight ? 'text-brand-primary' : 'text-white';
const tagText = isLight ? 'text-brand-primary-light' : 'text-brand-secondary';
const stepTitleText = isLight ? 'text-brand-primary' : 'text-white';
const stepDescText = isLight ? 'text-brand-primary/70' : 'text-white/60';
const watermarkColor = isLight ? 'rgba(2,28,8,0.05)' : 'rgba(166,191,172,0.06)';

// Panels with a background photo always use light-on-dark-overlay text,
// regardless of the section theme, since the photo needs a dark scrim.
const photoTagText = 'text-brand-secondary';
const photoTitleText = 'text-white';
const photoDescText = 'text-white/70';
const photoWatermarkColor = 'rgba(255,255,255,0.08)';

// If any panel carries a photo, the shared progress dots switch to the
// light-on-dark palette so they stay visible against the photo panels.
const dotActive = isLight && !hasAnyImage ? '#0d401b' : '#a6bfac';
const dotInactive = isLight && !hasAnyImage ? 'rgba(2,28,8,0.15)' : 'rgba(255,255,255,0.2)';
---

<section
  id="proceso"
  class={`js-process relative ${sectionBg} overflow-hidden`}
  data-dot-active={dotActive}
  data-dot-inactive={dotInactive}
>
  <!-- Horizontal track -->
  <div class="js-process-track flex flex-col md:flex-row">
    {
      steps.map((step, i) => (
        <div class="js-process-panel relative w-full md:w-screen h-screen flex-shrink-0 overflow-hidden flex items-center">
          {step.image && (
            <div class="absolute inset-0 z-0">
              <picture class="w-full h-full block">
                <source media="(max-width: 767px)" srcset={step.image.replace('.jpg', '-mobile.jpg')} />
                <img
                  src={step.image}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-brand-primary via-brand-primary/70 to-brand-primary/40" />
              <div class="absolute inset-0 bg-gradient-to-r from-brand-primary/85 via-brand-primary/25 to-transparent" />
            </div>
          )}

          {i === 0 && (
            <div class="absolute top-24 left-6 md:top-28 md:left-16 lg:left-20 z-20">
              <p class={`text-xs font-bold uppercase tracking-[0.3em] ${step.image ? photoTagText : eyebrowText} mb-3`}>
                {eyebrow}
              </p>
              <h2 class={`text-2xl md:text-3xl font-black uppercase tracking-tighter ${step.image ? photoTitleText : headingText} leading-tight`}>
                {title}
              </h2>
            </div>
          )}

          <!-- Index watermark -->
          <div
            aria-hidden="true"
            class="absolute right-6 bottom-6 font-black leading-none select-none pointer-events-none"
            style={{ fontSize: 'clamp(120px, 20vw, 260px)', color: step.image ? photoWatermarkColor : watermarkColor }}
          >
            {String(i + 1).padStart(2, '0')}
          </div>

          <div class="relative z-10 px-6 md:px-16 lg:px-20 max-w-xl">
            <span class={`js-process-tag text-[10px] md:text-xs font-black uppercase tracking-[0.4em] ${step.image ? photoTagText : tagText}`}>
              Paso {String(i + 1).padStart(2, '0')}
            </span>

            <h3
              class={`js-process-title font-black uppercase leading-[0.95] ${step.image ? photoTitleText : stepTitleText} mt-4`}
              style={{ fontSize: 'clamp(36px, 5vw, 72px)' }}
            >
              {step.title}
            </h3>

            <div class="js-process-line h-[2px] bg-brand-secondary mt-6 origin-left" style={{ width: '64px' }} />

            <p class={`js-process-desc text-base md:text-lg ${step.image ? photoDescText : stepDescText} mt-6 leading-relaxed max-w-md`}>
              {step.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Progress indicator — desktop only -->
  <div class="js-process-dots absolute bottom-6 left-1/2 -translate-x-1/2 z-30 hidden md:flex items-center gap-2">
    {
      steps.map((_, i) => (
        <div
          class="js-process-dot h-[2px] rounded-full transition-all duration-300"
          style={{ width: i === 0 ? '28px' : '14px', backgroundColor: i === 0 ? dotActive : dotInactive }}
        />
      ))
    }
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initProcessScroll = () => {
    const section = document.querySelector<HTMLElement>('.js-process');
    const track = document.querySelector<HTMLElement>('.js-process-track');
    if (!section || !track) return;

    const panels = Array.from(track.querySelectorAll<HTMLElement>('.js-process-panel'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('.js-process-dot'));
    const dotActive = section.dataset.dotActive || '#a6bfac';
    const dotInactive = section.dataset.dotInactive || 'rgba(255,255,255,0.2)';

    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      // ─── DESKTOP: pin + horizontal scroll ───────────────────────────
      mm.add('(min-width: 768px)', () => {
        track.style.width = `${panels.length * 100}vw`;

        const scrollTween = gsap.to(track, {
          x: () => -(track.scrollWidth - window.innerWidth),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            pin: true,
            scrub: 1.5,
            end: () => `+=${track.scrollWidth - window.innerWidth}`,
            invalidateOnRefresh: true,
            onUpdate(self) {
              const active = Math.round(self.progress * (panels.length - 1));
              dots.forEach((dot, i) => {
                dot.style.backgroundColor = i === active ? dotActive : dotInactive;
                dot.style.width = i === active ? '28px' : '14px';
              });
            },
          },
        });

        panels.forEach((panel) => {
          const common = {
            trigger: panel,
            containerAnimation: scrollTween,
            toggleActions: 'play none none reverse' as const,
          };

          const tag = panel.querySelector('.js-process-tag');
          if (tag) {
            gsap.fromTo(
              tag,
              { opacity: 0, x: -28 },
              { opacity: 1, x: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: { ...common, start: 'left 82%' } }
            );
          }

          const title = panel.querySelector('.js-process-title');
          if (title) {
            gsap.fromTo(
              title,
              { y: 60, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.9, ease: 'power4.out', scrollTrigger: { ...common, start: 'left 78%' } }
            );
          }

          const line = panel.querySelector('.js-process-line');
          if (line) {
            gsap.fromTo(
              line,
              { scaleX: 0 },
              { scaleX: 1, duration: 0.8, ease: 'power2.inOut', delay: 0.15, scrollTrigger: { ...common, start: 'left 78%' } }
            );
          }

          const desc = panel.querySelector('.js-process-desc');
          if (desc) {
            gsap.fromTo(
              desc,
              { opacity: 0, y: 24 },
              { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out', delay: 0.2, scrollTrigger: { ...common, start: 'left 78%' } }
            );
          }
        });

        return () => {
          track.style.width = '';
        };
      });

      // ─── MOBILE: stacked vertical panels ────────────────────────────
      mm.add('(max-width: 767px)', () => {
        panels.forEach((panel) => {
          const common = { trigger: panel, start: 'top 82%', toggleActions: 'play none none reverse' as const };

          const tag = panel.querySelector('.js-process-tag');
          if (tag) gsap.fromTo(tag, { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out', scrollTrigger: common });

          const title = panel.querySelector('.js-process-title');
          if (title) gsap.fromTo(title, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', scrollTrigger: common });

          const line = panel.querySelector('.js-process-line');
          if (line) gsap.fromTo(line, { scaleX: 0 }, { scaleX: 1, duration: 0.7, ease: 'power2.inOut', delay: 0.1, scrollTrigger: common });

          const desc = panel.querySelector('.js-process-desc');
          if (desc) gsap.fromTo(desc, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', delay: 0.15, scrollTrigger: common });
        });
      });
    }, section);

    return () => ctx.revert();
  };

  initProcessScroll();
  document.addEventListener('astro:page-load', initProcessScroll);
</script>
