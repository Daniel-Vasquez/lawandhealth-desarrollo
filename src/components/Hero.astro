---
interface TrustIndicator {
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  paragraph: string;
  indicators: TrustIndicator[];
  ctaLabel: string;
  ctaHref: string;
}

const {
  eyebrow = 'Regulación Sanitaria',
  title,
  paragraph,
  indicators,
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<section id="inicio" class="js-hero relative w-full min-h-screen flex items-center overflow-hidden pt-24 pb-16 md:pt-0 md:pb-0 bg-brand-primary">
  <!-- Decorative background -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="js-hero-blob absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full opacity-20 blur-3xl"
      style={{ background: 'radial-gradient(circle, #0d401b 0%, transparent 70%)' }}
    ></div>
    <div
      class="js-hero-blob absolute bottom-0 left-1/4 w-[400px] h-[400px] rounded-full opacity-10 blur-3xl"
      style={{ background: 'radial-gradient(circle, #a6bfac 0%, transparent 70%)' }}
    ></div>
  </div>

  <!-- Accent top bar -->
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-brand-secondary z-10"></div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
    <p class="js-hero-eyebrow text-xs font-bold uppercase tracking-[0.4em] text-brand-secondary mb-6">
      {eyebrow}
    </p>

    <h1 class="js-hero-title font-black leading-[1.05] text-white max-w-4xl" style={{ fontSize: 'clamp(32px, 5.5vw, 64px)' }}>
      {title}
    </h1>

    <p class="js-hero-paragraph text-base md:text-lg text-white/70 max-w-2xl mt-6 leading-relaxed">
      {paragraph}
    </p>

    <!-- Trust indicators -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 mt-10 max-w-2xl">
      {
        indicators.map((indicator) => (
          <li class="js-hero-indicator flex items-start gap-3">
            <svg class="w-5 h-5 flex-shrink-0 text-brand-secondary mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-sm text-white/80 font-medium">{indicator.label}</span>
          </li>
        ))
      }
    </ul>

    <!-- CTA -->
    <a
      href={ctaHref}
      class="js-hero-cta group inline-flex items-center gap-3 bg-brand-secondary text-black font-black uppercase text-sm tracking-widest px-8 py-4 mt-10 hover:bg-white transition-colors duration-200"
    >
      {ctaLabel}
      <svg
        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const hero = document.querySelector('.js-hero');
    if (!hero) return;

    // Entrance animation — staggered reveal on load
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo('.js-hero-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
      .fromTo('.js-hero-title', { opacity: 0, y: 32 }, { opacity: 1, y: 0, duration: 0.9 }, '<0.1')
      .fromTo('.js-hero-paragraph', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, '<0.2')
      .fromTo('.js-hero-indicator', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 }, '<0.15')
      .fromTo('.js-hero-cta', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, '<0.1');

    // Scroll-tied parallax on decorative blobs
    gsap.utils.toArray<HTMLElement>('.js-hero-blob').forEach((blob, i) => {
      gsap.to(blob, {
        y: i % 2 === 0 ? 120 : -120,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    });
  };

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
