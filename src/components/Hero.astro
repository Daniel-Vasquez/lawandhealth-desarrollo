---
interface TrustIndicator {
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  paragraph: string;
  indicators: TrustIndicator[];
  ctaLabel: string;
  ctaHref: string;
}

const {
  eyebrow = "Regulación Sanitaria",
  title,
  paragraph,
  indicators,
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<section
  id="inicio"
  class="js-hero relative w-full min-h-screen flex items-center overflow-hidden pt-24 pb-16 md:pt-0 md:pb-0 bg-brand-primary"
>
  <!-- Base photo — always visible -->
  <div
    class="absolute inset-0 z-0"
    style={{
      backgroundImage: "url('images/hero-light.webp')",
      backgroundSize: "cover",
      backgroundPosition: "85% 50%",
    }}
  >
  </div>

  <!-- Reveal photo — only visible inside the cursor-following spotlight -->
  <div
    class="js-hero-reveal absolute inset-0 z-[1] pointer-events-none hidden md:block"
    style={{
      backgroundImage: "url('images/hero-dark.webp')",
      backgroundSize: "cover",
      backgroundPosition: "center",
      WebkitMaskImage:
        "radial-gradient(circle at -999px -999px, black 0, transparent 0)",
      maskImage:
        "radial-gradient(circle at -999px -999px, black 0, transparent 0)",
    }}
  >
  </div>
  <canvas class="js-hero-spotlight-canvas hidden"></canvas>

  <!-- Legibility overlay — flat/strong on mobile (text spans full width), side gradient on desktop (text sits left) -->
  <div class="absolute inset-0 z-[2] bg-brand-primary/40 pointer-events-none">
  </div>
  <div
    class="absolute inset-0 z-[2] hidden md:block from-brand-primary via-brand-primary/75 to-brand-primary/30 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 z-[2] bg-brand-primary/60 pointer-events-none md:bg-brand-primary/30"
  >
  </div>

  <!-- Accent top bar -->
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-brand-secondary z-10">
  </div>

  <!-- Content -->
  <div
    class="relative z-10 w-full max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20"
  >
    <p
      class="js-hero-eyebrow text-xs font-bold uppercase tracking-[0.4em] text-brand-secondary mb-6"
    >
      {eyebrow}
    </p>

    <h1
      class="js-hero-title font-black leading-[1.05] text-white max-w-5xl"
      style={{ fontSize: "clamp(32px, 5.5vw, 64px)" }}
    >
      {title}
    </h1>

    <p
      class="js-hero-paragraph text-base md:text-lg text-white/70 max-w-3xl mt-6 leading-relaxed"
    >
      {paragraph}
    </p>

    <!-- Trust indicators -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 mt-10 max-w-2xl">
      {
        indicators.map((indicator) => (
          <li class="js-hero-indicator flex items-start gap-3">
            <svg
              class="w-5 h-5 flex-shrink-0 text-brand-secondary mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 12.75l6 6 9-13.5"
              />
            </svg>
            <span class="text-sm text-white/80 font-medium">
              {indicator.label}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- CTA -->
    <a
      href={ctaHref}
      class="js-hero-cta group inline-flex items-center gap-3 bg-brand-secondary text-black font-black uppercase text-sm tracking-widest px-8 py-4 mt-10 hover:bg-white transition-colors duration-200"
    >
      {ctaLabel}
      <svg
        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const hero = document.querySelector(".js-hero");
    if (!hero) return;

    // Entrance animation — staggered reveal on load
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    tl.fromTo(
      ".js-hero-eyebrow",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.6 },
    )
      .fromTo(
        ".js-hero-title",
        { opacity: 0, y: 32 },
        { opacity: 1, y: 0, duration: 0.9 },
        "<0.1",
      )
      .fromTo(
        ".js-hero-paragraph",
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.7 },
        "<0.2",
      )
      .fromTo(
        ".js-hero-indicator",
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 },
        "<0.15",
      )
      .fromTo(
        ".js-hero-cta",
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.6 },
        "<0.1",
      );
  };

  initHero();
  document.addEventListener("astro:page-load", initHero);

  // ─── Spotlight reveal — cursor-following canvas mask ──────────────
  // Desktop-only (hover + fine pointer), disabled under reduced-motion.
  let spotlightCleanup: (() => void) | null = null;

  const initSpotlight = () => {
    spotlightCleanup?.();
    spotlightCleanup = null;

    const hero = document.querySelector<HTMLElement>(".js-hero");
    const revealLayer = document.querySelector<HTMLElement>(".js-hero-reveal");
    const canvas = document.querySelector<HTMLCanvasElement>(
      ".js-hero-spotlight-canvas",
    );
    if (!hero || !revealLayer || !canvas) return;

    const supportsHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (!supportsHover || reducedMotion) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const RADIUS = 260;
    const mouse = { x: -999, y: -999 };
    const smooth = { x: -999, y: -999 };
    let rafId = 0;
    let active = false;

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    };

    const onPointerMove = (e: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      active = true;
    };

    const onPointerLeave = () => {
      active = false;
      mouse.x = -999;
      mouse.y = -999;
    };

    const draw = () => {
      smooth.x += (mouse.x - smooth.x) * 0.1;
      smooth.y += (mouse.y - smooth.y) * 0.1;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (active || Math.abs(smooth.x - mouse.x) > 0.5) {
        const grad = ctx.createRadialGradient(
          smooth.x,
          smooth.y,
          0,
          smooth.x,
          smooth.y,
          RADIUS,
        );
        grad.addColorStop(0, "rgba(255,255,255,1)");
        grad.addColorStop(0.4, "rgba(255,255,255,1)");
        grad.addColorStop(0.6, "rgba(255,255,255,0.75)");
        grad.addColorStop(0.75, "rgba(255,255,255,0.4)");
        grad.addColorStop(0.88, "rgba(255,255,255,0.12)");
        grad.addColorStop(1, "rgba(255,255,255,0)");

        ctx.beginPath();
        ctx.arc(smooth.x, smooth.y, RADIUS, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();

        const dataUrl = canvas.toDataURL();
        revealLayer.style.maskImage = `url(${dataUrl})`;
        (revealLayer.style as any).webkitMaskImage = `url(${dataUrl})`;
        revealLayer.style.maskSize = "100% 100%";
        (revealLayer.style as any).webkitMaskSize = "100% 100%";
      }

      rafId = requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);
    hero.addEventListener("pointermove", onPointerMove);
    hero.addEventListener("pointerleave", onPointerLeave);
    rafId = requestAnimationFrame(draw);

    spotlightCleanup = () => {
      cancelAnimationFrame(rafId);
      window.removeEventListener("resize", resize);
      hero.removeEventListener("pointermove", onPointerMove);
      hero.removeEventListener("pointerleave", onPointerLeave);
    };
  };

  initSpotlight();
  document.addEventListener("astro:page-load", initSpotlight);
</script>
