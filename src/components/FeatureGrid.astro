---
interface Feature {
  title: string;
  description: string;
  image?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  features: Feature[];
  background?: 'primary' | 'tint';
}

const { id, eyebrow, title, features, background = 'primary' } = Astro.props;

const sectionBg = background === 'tint' ? 'bg-brand-primary-light/10' : 'bg-brand-primary';
---

<section id={id} class={`reveal ${sectionBg} py-20 md:py-28`}>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-12 md:mb-16 max-w-2xl">
      {eyebrow && <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-3">{eyebrow}</p>}
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter text-white leading-tight">
        {title}
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/5">
      {
        features.map((feature, i) => (
          <div class="group relative bg-brand-primary p-8 flex flex-col overflow-hidden">
            {feature.image ? (
              <div class="relative -mx-8 -mt-8 mb-6 aspect-[4/3] overflow-hidden">
                <img
                  src={feature.image}
                  alt=""
                  class="w-full h-full object-cover grayscale opacity-70 transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-brand-primary/40" />
              </div>
            ) : (
              <span class="block font-black text-brand-secondary/40 mb-6" style={{ fontSize: '2.5rem', lineHeight: 1 }}>
                {String(i + 1).padStart(2, '0')}
              </span>
            )}
            <h3 class="text-lg font-black uppercase tracking-tight text-white mb-2">{feature.title}</h3>
            <p class="text-sm text-white/60 leading-relaxed">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
