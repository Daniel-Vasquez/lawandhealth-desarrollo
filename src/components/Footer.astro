---
interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const contactDetails = [
  { label: 'Correo', value: 'contacto@lawandhealth.mx', href: 'mailto:contacto@lawandhealth.mx' },
  { label: 'Teléfono', value: '+52 (55) 0000 0000', href: 'tel:+525500000000' },
  { label: 'Cobertura', value: 'Toda la República Mexicana' },
];
---

<footer class="bg-brand-primary border-t border-white/10">
  <!-- Top section -->
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-brand-secondary flex items-center justify-center">
            <span class="text-black font-black text-base tracking-tighter">LH</span>
          </div>
          <div>
            <p class="font-black text-white uppercase tracking-wider text-sm">Law &amp; Health</p>
            <p class="text-brand-secondary text-xs uppercase tracking-widest">Regulación Sanitaria</p>
          </div>
        </div>
        <p class="text-white/40 text-sm leading-relaxed max-w-xs">
          Asesoría especializada en regulación sanitaria para empresas del sector salud y alimenticio en toda la República Mexicana.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-6">Navegación</h3>
        <ul class="flex flex-col gap-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-white/50 hover:text-white text-sm font-medium uppercase tracking-widest transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-6">Contacto</h3>
        <ul class="flex flex-col gap-3">
          {
            contactDetails.map((item) => (
              <li>
                {item.href ? (
                  <a
                    href={item.href}
                    class="text-white/50 hover:text-white text-sm font-medium transition-colors duration-200"
                  >
                    {item.value}
                  </a>
                ) : (
                  <span class="text-white/50 text-sm font-medium">{item.value}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-white/5">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/20 text-xs uppercase tracking-widest">
        &copy; {new Date().getFullYear()} Law &amp; Health. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200">
          Aviso de Privacidad
        </a>
        <a href="#" class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200">
          Términos de Uso
        </a>
      </div>
    </div>
  </div>

  <!-- Accent line -->
  <div class="h-0.5 bg-brand-secondary"></div>
</footer>
