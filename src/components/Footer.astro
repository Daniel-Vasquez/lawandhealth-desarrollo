---
interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const socialLinks = [
  { name: 'Instagram', href: 'https://www.instagram.com/lawandhealth', handle: '@lawandhealth' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@lawandhealth', handle: '@lawandhealth' },
  { name: 'YouTube', href: 'https://www.youtube.com/lawandhealth', handle: 'Lawandhealth' },
  { name: 'X', href: 'https://twitter.com/lawandhealth', handle: '@lawandhealth' },
  { name: 'Twitch', href: 'https://www.twitch.tv/lawandhealth', handle: 'lawandhealth' },
];
---

<footer class="bg-brand-primary border-t border-white/10">
  <!-- Top section -->
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-brand-secondary flex items-center justify-center">
            <span class="text-black font-black text-base tracking-tighter">LH</span>
          </div>
          <div>
            <p class="font-black text-white uppercase tracking-wider text-sm">Lawandhealth</p>
            <p class="text-brand-secondary text-xs uppercase tracking-widest">#4 McLaren F1</p>
          </div>
        </div>
        <p class="text-white/40 text-sm leading-relaxed max-w-xs">
          Official website of Lawandhealth — 2025 McLaren Formula 1 Driver. Racing, lifestyle, and more.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-6">Navigate</h3>
        <ul class="flex flex-col gap-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-white/50 hover:text-white text-sm font-medium uppercase tracking-widest transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-brand-secondary mb-6">Social</h3>
        <ul class="flex flex-col gap-3">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-white/50 hover:text-brand-secondary text-sm font-medium transition-colors duration-200 group"
                >
                  <span class="uppercase tracking-widest">{social.name}</span>
                  <span class="text-white/20 group-hover:text-brand-secondary/40 text-xs">·</span>
                  <span class="text-white/30 group-hover:text-brand-secondary/60 text-xs">{social.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-white/5">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/20 text-xs uppercase tracking-widest">
        &copy; {new Date().getFullYear()} Lawandhealth. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200">
          Privacy Policy
        </a>
        <a href="#" class="text-white/20 hover:text-white/50 text-xs uppercase tracking-widest transition-colors duration-200">
          Terms of Use
        </a>
      </div>
    </div>
  </div>

  <!-- Lime bottom line -->
  <div class="h-0.5 bg-brand-secondary"></div>
</footer>
