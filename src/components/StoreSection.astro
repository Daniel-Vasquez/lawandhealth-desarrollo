---
interface Props {
  storeUrl?: string;
}

const { storeUrl = "https://store.lawandhealth.com" } = Astro.props;
---

<section
  id="store"
  class="relative overflow-hidden min-h-[80vh] flex items-center"
>
  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src="/images/store-bg.jpg"
      alt="Lawandhealth Championship Merchandise"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-brand-primary/70"></div>
    <!-- Gold tint overlay -->
    <div class="absolute inset-0 bg-brand-primary-light/10"></div>
  </div>

  <!-- Decorative corner accents -->
  <div
    class="absolute top-8 left-8 w-12 h-12 border-t-2 border-l-2 border-brand-primary-light"
  >
  </div>
  <div
    class="absolute top-8 right-8 w-12 h-12 border-t-2 border-r-2 border-brand-primary-light"
  >
  </div>
  <div
    class="absolute bottom-8 left-8 w-12 h-12 border-b-2 border-l-2 border-brand-primary-light"
  >
  </div>
  <div
    class="absolute bottom-8 right-8 w-12 h-12 border-b-2 border-r-2 border-brand-primary-light"
  >
  </div>

  <!-- Content -->
  <div
    class="relative z-10 w-full max-w-[1400px] mx-auto px-6 lg:px-10 py-24 text-center"
  >
    <p
      class="text-xs font-bold uppercase tracking-[0.4em] text-brand-primary-light mb-4"
    >
      Official Merchandise
    </p>
    <h2
      class="text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter text-white leading-none mb-6"
    >
      LH Store
    </h2>
    <p
      class="text-base md:text-lg text-white/60 max-w-lg mx-auto mb-10 font-medium"
    >
      Championship edition gear. Wear the legacy. Limited availability.
    </p>
    <a
      href={storeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-3 bg-brand-primary-light text-white font-black uppercase text-sm tracking-widest px-8 py-4 hover:bg-white hover:text-black transition-colors duration-200"
    >
      Shop Now
      <svg
        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</section>
