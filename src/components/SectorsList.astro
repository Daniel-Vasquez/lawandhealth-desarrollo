---
interface SectorItem {
  name: string;
  image: string;
}

interface Sector {
  title: string;
  items: SectorItem[];
}

interface Props {
  eyebrow?: string;
  title: string;
  theme?: "dark" | "light";
}

const { eyebrow = "Cobertura", title, theme = "dark" } = Astro.props;
const isLight = theme === "light";

const sectors: Sector[] = [
  {
    title: "Sector Salud",
    items: [
      {
        name: "Hospitales",
        image: "images/sector-salud/sector-salud-hospitales.webp",
      },
      {
        name: "Clínicas",
        image: "images/sector-salud/sector-salud-clinica.webp",
      },
      {
        name: "Consultorios",
        image: "images/sector-salud/sector-salud-consultorio.webp",
      },
      {
        name: "Laboratorios",
        image: "images/sector-salud/sector-salud-laboratorios.webp",
      },
      {
        name: "Farmacias",
        image: "images/sector-salud/sector-salud-farmacia.webp",
      },
      {
        name: "Distribuidores de medicamentos",
        image:
          "images/sector-salud/sector-salud-distribuidores-medicamentos.webp",
      },
      {
        name: "Empresas de dispositivos médicos",
        image:
          "images/sector-salud/sector-salud-empresas-dispositivos-medicos.webp",
      },
      {
        name: "Servicios de diagnóstico",
        image: "images/sector-salud/sector-salud-servicios-diagnostico.webp",
      },
    ],
  },
  {
    title: "Sector Alimenticio",
    items: [
      {
        name: "Fabricantes",
        image: "images/sector-alimenticio/sector-alimenticio-fabricantes.webp",
      },
      {
        name: "Productores",
        image: "images/sector-alimenticio/sector-alimenticio-productores.webp",
      },
      {
        name: "Comercializadores",
        image:
          "images/sector-alimenticio/sector-alimenticio-comercializadores.webp",
      },
      {
        name: "Restaurantes",
        image: "images/sector-alimenticio/sector-alimenticio-restaurantes.webp",
      },
      {
        name: "Empresas de bebidas",
        image:
          "images/sector-alimenticio/sector-alimenticio-empresas-bebidas.webp",
      },
      {
        name: "Suplementos alimenticios",
        image:
          "images/sector-alimenticio/sector-alimenticio-suplementos-alimenticios.webp",
      },
    ],
  },
];

const sectionBg = isLight ? "bg-white" : "bg-brand-primary";
const eyebrowText = isLight
  ? "text-brand-primary-light"
  : "text-brand-secondary";
const headingText = isLight ? "text-brand-primary" : "text-white";
const cardBg = isLight ? "bg-white" : "bg-brand-primary";
const cardBorder = isLight ? "border-black/10" : "border-white/10";
const cardHeadingText = isLight ? "text-brand-primary" : "text-white";

// Scrim over the background photo, tinted with the card's own color so the
// palette stays untouched while the title keeps enough contrast to read.
const imageOverlay = isLight
  ? "from-white via-white/70"
  : "from-brand-primary via-brand-primary/70";

// Bento sizing inside each sector's sub-grid: a hand-placed pattern (not a
// repeating grid) keeps the composition asymmetric within a 2-column track.
function getSpanClasses(i: number) {
  switch (i) {
    case 0: // hero tile
      return "col-span-2 row-span-2";
    case 3: // wide tile
      return "col-span-2";
    case 5: // tall tile
      return "row-span-2";
    case 6: // wide tile
      return "col-span-1";
    default:
      return "";
  }
}

function isFeature(i: number) {
  return i === 0;
}
---

<section id="sectores" class={`reveal ${sectionBg} py-20 md:py-28`}>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-12 md:mb-16 max-w-2xl">
      <p
        class={`text-xs font-bold uppercase tracking-[0.3em] ${eyebrowText} mb-3`}
      >
        {eyebrow}
      </p>
      <h2
        class={`text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter ${headingText} leading-tight`}
      >
        {title}
      </h2>
    </div>

    <!-- Main 2-column layout: one column per sector -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        sectors.map((sector) => (
          <div>
            {/* Sector title, shown once at the top of its column */}
            <h3
              class={`pb-6 mb-8 border-b ${cardBorder} text-2xl md:text-3xl font-black uppercase tracking-tighter ${cardHeadingText}`}
            >
              {sector.title}
            </h3>

            {/* Sector sub-grid (Bento Box) */}
            <div class="grid grid-cols-2 gap-4 md:gap-6 auto-rows-[170px] md:auto-rows-[190px]">
              {sector.items.map((item, i) => (
                <div
                  class={`group relative overflow-hidden h-full ${cardBg} border ${cardBorder} ${getSpanClasses(i)}`}
                >
                  {/* Background image, cropped without distortion whatever the tile's shape */}
                  <div class="absolute inset-0">
                    <img
                      src={item.image}
                      alt=""
                      class="w-full h-full object-cover transition-transform cursor-pointer duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                    <div
                      class={`absolute inset-0 bg-gradient-to-t ${imageOverlay} to-transparent`}
                    />
                  </div>

                  {/* Content: item title only, anchored to the bottom over the scrim */}
                  <div class="relative h-full flex flex-col justify-end p-5 md:p-6">
                    <h4
                      class={`${isFeature(i) ? "text-xl md:text-2xl" : "text-base md:text-lg"} font-black uppercase tracking-tighter ${cardHeadingText} leading-tight`}
                    >
                      {item.name}
                    </h4>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
