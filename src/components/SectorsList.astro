---
interface Sector {
  title: string;
  items: string[];
}

interface Props {
  eyebrow?: string;
  title: string;
  sectors: Sector[];
  theme?: 'dark' | 'light';
}

const { eyebrow = 'Cobertura', title, sectors, theme = 'dark' } = Astro.props;
const isLight = theme === 'light';

const sectionBg = isLight ? 'bg-white' : 'bg-brand-primary';
const eyebrowText = isLight ? 'text-brand-primary-light' : 'text-brand-secondary';
const headingText = isLight ? 'text-brand-primary' : 'text-white';
const gridBg = isLight ? 'bg-black/5' : 'bg-white/5';
const cardBg = isLight ? 'bg-white' : 'bg-brand-primary';
const cardBorder = isLight ? 'border-black/10' : 'border-white/10';
const cardHeadingText = isLight ? 'text-brand-primary' : 'text-white';
const iconBoxBg = isLight ? 'bg-brand-primary-light/5' : 'bg-brand-secondary/10';
const iconBoxBorder = isLight ? 'border-brand-primary-light/30' : 'border-brand-secondary/40';
const iconColor = isLight ? 'text-brand-primary-light' : 'text-brand-secondary';
const itemText = isLight ? 'text-brand-primary/70' : 'text-white/70';
---

<section id="sectores" class={`reveal ${sectionBg} py-20 md:py-28`}>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-12 md:mb-16 max-w-2xl">
      <p class={`text-xs font-bold uppercase tracking-[0.3em] ${eyebrowText} mb-3`}>{eyebrow}</p>
      <h2 class={`text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter ${headingText} leading-tight`}>
        {title}
      </h2>
    </div>

    <!-- Sectors -->
    <div class={`grid grid-cols-1 md:grid-cols-2 gap-px ${gridBg}`}>
      {
        sectors.map((sector) => (
          <div class={`${cardBg} p-8 md:p-10`}>
            <div class={`flex items-center gap-3 mb-6 pb-6 border-b ${cardBorder}`}>
              <div class={`w-10 h-10 flex-shrink-0 ${iconBoxBg} border ${iconBoxBorder} flex items-center justify-center`}>
                <svg class={`w-5 h-5 ${iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                </svg>
              </div>
              <h3 class={`text-2xl md:text-3xl font-black uppercase tracking-tighter ${cardHeadingText}`}>
                {sector.title}
              </h3>
            </div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
              {sector.items.map((item) => (
                <li class={`flex items-center gap-2 text-sm ${itemText}`}>
                  <span class="w-1 h-1 rounded-full bg-brand-secondary flex-shrink-0" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
