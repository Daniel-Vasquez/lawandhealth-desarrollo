---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import Hero from "../components/Hero.astro";
import ChallengesGrid from "../components/ChallengesGrid.astro";
import IntroStatement from "../components/IntroStatement.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import SectorsList from "../components/SectorsList.astro";
import ProcessScroll from "../components/ProcessScroll.astro";
import Partnerships from "../components/Partnerships.astro";
import CaseStudies from "../components/CaseStudies.astro";
import FAQ from "../components/FAQ";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

const CONTACT_HREF = "#contacto";

const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Sectores", href: "#sectores" },
  { label: "Proceso", href: "#proceso" },
  { label: "Casos de Éxito", href: "#casos-de-exito" },
  { label: "FAQ", href: "#faq" },
];

const heroIndicators = [
  { label: "Más de 150 empresas atendidas." },
  { label: "Especialistas en Regulación Sanitaria." },
  { label: "Cobertura en toda la República Mexicana." },
  { label: "Respuesta en menos de 24 horas." },
];

const challenges = [
  { title: "Verificación sanitaria" },
  { title: "Suspensión de actividades" },
  { title: "Multas administrativas" },
  { title: "Apertura de establecimientos" },
  { title: "Regularización documental" },
  { title: "Permisos y autorizaciones" },
  { title: "Publicidad de productos o servicios regulados" },
  { title: "Certificaciones" },
];

const services = [
  {
    title: "Cumplimiento regulatorio",
    description: "Asesoría para cumplir con la normativa sanitaria aplicable.",
  },
  {
    title: "Permisos, licencias y autorizaciones",
    description:
      "Gestión e integración de expedientes para procesos regulatorios.",
  },
  {
    title: "Atención de verificaciones",
    description:
      "Acompañamiento durante verificaciones sanitarias y requerimientos de la autoridad.",
  },
  {
    title: "Defensa administrativa",
    description:
      "Atención de multas, procedimientos administrativos y medios de defensa.",
  },
];

const whyChooseUs = [
  {
    title: "Especialización",
    description:
      "Equipo conformado por especialistas en distintas áreas de la Regulación Sanitaria.",
  },
  {
    title: "Experiencia",
    description: "Más de 150 empresas atendidas desde 2018.",
  },
  {
    title: "Atención personalizada",
    description:
      "Estrategias desarrolladas con base en la situación y necesidades de cada empresa.",
  },
  {
    title: "Cobertura nacional",
    description: "Atención para empresas de toda la República Mexicana.",
  },
];

const sectors = [
  {
    title: "Sector Salud",
    items: [
      "Hospitales",
      "Clínicas",
      "Consultorios",
      "Laboratorios",
      "Farmacias",
      "Servicios de diagnóstico",
      "Distribuidores de medicamentos",
      "Dispositivos médicos",
    ],
  },
  {
    title: "Sector Alimenticio",
    items: [
      "Fabricantes",
      "Productores",
      "Comercializadores",
      "Restaurantes",
      "Bebidas alcohólicas",
      "Suplementos alimenticios",
    ],
  },
];

const processSteps = [
  {
    title: "Evaluación del caso",
    description: "Analizamos la situación y los objetivos de la empresa.",
    image: "/images/nuestro-proceso-1.webp",
  },
  {
    title: "Estrategia regulatoria",
    description: "Definimos el plan de acción.",
    image: "/images/nuestro-proceso-2.webp",
  },
  {
    title: "Implementación",
    description: "Ejecutamos el procedimiento y acompañamos el proceso.",
    image: "/images/nuestro-proceso-3.webp",
  },
  {
    title: "Seguimiento",
    description:
      "Brindamos apoyo continuo conforme a las necesidades regulatorias del cliente.",
    image: "/images/nuestro-proceso-4.webp",
  },
];

// Pendiente: sustituir por los logotipos reales una vez autorizados por cada cliente.
const clients = Array.from({ length: 10 }, (_, i) => ({
  name: `Empresa ${String(i + 1).padStart(2, "0")}`,
}));

// Pendiente: sustituir por los tres casos de éxito reales (Problema / Solución / Resultado).
const caseStudies = [
  {
    problema: "Contenido pendiente de definir con el cliente.",
    solucion: "Contenido pendiente de definir con el cliente.",
    resultado: "Contenido pendiente de definir con el cliente.",
  },
  {
    problema: "Contenido pendiente de definir con el cliente.",
    solucion: "Contenido pendiente de definir con el cliente.",
    resultado: "Contenido pendiente de definir con el cliente.",
  },
  {
    problema: "Contenido pendiente de definir con el cliente.",
    solucion: "Contenido pendiente de definir con el cliente.",
    resultado: "Contenido pendiente de definir con el cliente.",
  },
];

// Pendiente: redactar las respuestas definitivas de cada pregunta.
const faqItems = [
  {
    question: "¿Atienden empresas de toda la República Mexicana?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Atienden procedimientos urgentes?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Qué sucede después de enviar el formulario?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Cuánto tiempo tarda el primer contacto?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
];
---

<Layout>
  <Navigation
    client:load
    links={navLinks}
    ctaLabel="Solicitar evaluación"
    ctaHref={CONTACT_HREF}
  />

  <main>
    <Hero
      title="Asesoría Especializada en Regulación Sanitaria para Empresas del Sector Salud y Alimenticio"
      paragraph="Protege la operación de tu empresa con el respaldo de especialistas en regulación sanitaria. Asesoramos a organizaciones del sector salud y alimenticio en procesos ante COFEPRIS, cumplimiento de Normas Oficiales Mexicanas (NOM), permisos, licencias, verificaciones sanitarias y procedimientos administrativos."
      indicators={heroIndicators}
      ctaLabel="Solicitar una evaluación regulatoria"
      ctaHref={CONTACT_HREF}
    />

    <ChallengesGrid
      title="¿Tu empresa enfrenta alguno de estos desafíos?"
      challenges={challenges}
      ctaLabel="Hablar con un especialista"
      ctaHref={CONTACT_HREF}
    />

    <IntroStatement
      title="Protegemos la operación de empresas del sector salud y alimenticio."
      paragraph="La regulación sanitaria influye directamente en la continuidad de una empresa. Lawandhealth desarrolla estrategias legales y regulatorias para prevenir riesgos, atender procedimientos administrativos y fortalecer el cumplimiento normativo."
      theme="light"
    />

    <FeatureGrid
      id="servicios"
      eyebrow="Qué hacemos"
      title="Servicios especializados"
      features={services}
      theme="dark"
    />

    <FeatureGrid
      id="por-que-elegirnos"
      eyebrow="Diferenciadores"
      title="¿Por qué elegir Lawandhealth?"
      features={whyChooseUs}
      theme="light"
    />

    <SectorsList
      title="Sectores que asesoramos"
      sectors={sectors}
      theme="dark"
    />

    <ProcessScroll title="Nuestro proceso" steps={processSteps} theme="light" />

    <Partnerships partners={clients} theme="dark" />

    <CaseStudies title="Casos de éxito" cases={caseStudies} theme="light" />

    <FAQ
      client:visible
      title="Preguntas frecuentes"
      items={faqItems}
      theme="dark"
    />

    <FinalCTA
      title="Solicita una evaluación regulatoria para tu empresa"
      paragraph="Si tu empresa pertenece al sector salud o alimenticio y requiere asesoría en regulación sanitaria, agenda una evaluación con uno de nuestros especialistas. Analizaremos tu situación y definiremos la mejor estrategia para atenderla."
      theme="light"
    />
  </main>

  <Footer navLinks={navLinks} />
</Layout>
