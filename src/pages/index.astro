---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import Hero from "../components/Hero.astro";
import ChallengesGrid from "../components/ChallengesGrid.astro";
import IntroStatement from "../components/IntroStatement.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import SectorsList from "../components/SectorsList.astro";
import ProcessScroll from "../components/ProcessScroll.astro";
import Partnerships from "../components/Partnerships.astro";
import CaseStudies from "../components/CaseStudies.astro";
import FAQ from "../components/FAQ";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

const CONTACT_HREF = "#contacto";

const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Sectores", href: "#sectores" },
  { label: "Proceso", href: "#proceso" },
  { label: "Casos de Éxito", href: "#casos-de-exito" },
  { label: "FAQ", href: "#faq" },
];

const heroIndicators = [
  { label: "Más de 150 empresas atendidas." },
  { label: "Especialistas en Regulación Sanitaria." },
  { label: "Cobertura en toda la República Mexicana." },
  { label: "Respuesta en menos de 24 horas." },
];

const services = [
  {
    title: "Permisos, licencias y autorizaciones",
    description:
      "Gestión y acompañamiento en procedimientos regulatorios necesarios para operar conforme a la legislación sanitaria.",
    image:
      "/images/servicios-especializados/Permisos, licencias y autorizaciones.webp",
  },
  {
    title: "Verificaciones y procedimientos ante COFEPRIS",
    description:
      "Asesoría durante visitas de verificación, requerimientos, medidas de seguridad y procedimientos administrativos.",
    image:
      "/images/servicios-especializados/Verificaciones y procedimientos ante COFEPRIS.webp",
  },
  {
    title: "Cumplimiento de Normas Oficiales Mexicanas (NOM)",
    description:
      "Implementación y seguimiento del cumplimiento regulatorio aplicable a la operación de tu empresa.",
    image:
      "/images/servicios-especializados/Cumplimiento de Normas Oficiales Mexicanas (NOM).webp",
  },
  {
    title: "Publicidad Sanitaria",
    description:
      "Revisión y asesoría para campañas, materiales y estrategias de comunicación sujetas a regulación sanitaria.",
    image: "/images/servicios-especializados/Publicidad Sanitaria.webp",
  },
  {
    title: "Responsable Sanitario",
    description:
      "Asesoría relacionada con las obligaciones y responsabilidades del Responsable Sanitario conforme a la normativa vigente.",
    image: "/images/servicios-especializados/Responsable Sanitario.webp",
  },
  {
    title: "Defensa administrativa",
    description:
      "Atención de sanciones, multas, recursos y procedimientos derivados de actos de autoridad.",
    image: "/images/servicios-especializados/Defensa administrativa.webp",
  },
];

const whyChooseUs = [
  {
    title: "Especialización",
    description:
      "Equipo conformado por especialistas en distintas áreas de la Regulación Sanitaria.",
    image: "/images/diferenciadores/Especializacion.webp",
  },
  {
    title: "Experiencia",
    description: "Más de 150 empresas atendidas desde 2018.",
    image: "/images/diferenciadores/Experiencia.webp",
  },
  {
    title: "Estrategias personalizadas",
    description:
      "Análisis de riesgos y desarrollo de soluciones alineadas con los objetivos de cada empresa.",
    image: "/images/diferenciadores/Estrategias.webp",
  },
  {
    title: "Cobertura nacional",
    description:
      "Atención a empresas del sector salud y alimenticio en toda la República Mexicana.",
    image: "/images/diferenciadores/Cobertura nacional.webp",
  },
];

const processSteps = [
  {
    title: "Evaluación del caso",
    description:
      "Analizamos la situación regulatoria y las necesidades de tu empresa.",
    image: "/images/nuestro-proceso-1.webp",
  },
  {
    title: "Estrategia",
    description:
      "Definimos el plan de acción conforme a la regulación aplicable.",
    image: "/images/nuestro-proceso-2.webp",
  },
  {
    title: "Implementación",
    description:
      "Acompañamos el procedimiento hasta atender el objetivo planteado.",
    image: "/images/nuestro-proceso-3.webp",
  },
  {
    title: "Seguimiento",
    description:
      "Brindamos apoyo para fortalecer el cumplimiento regulatorio de tu operación.",
    image: "/images/nuestro-proceso-4.webp",
  },
];

// Pendiente: sustituir por los logotipos reales una vez autorizados por cada cliente.
const clients = Array.from({ length: 10 }, (_, i) => ({
  name: `Empresa ${String(i + 1).padStart(2, "0")}`,
}));

// Pendiente: redactar las respuestas definitivas de cada pregunta.
const faqItems = [
  {
    question: "¿Atienden empresas de toda la República Mexicana?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Atienden procedimientos urgentes?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Qué sucede después de enviar el formulario?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
  {
    question: "¿Cuánto tiempo tarda el primer contacto?",
    answer: "Respuesta pendiente de redactar por el equipo de Lawandhealth.",
  },
];
---

<Layout>
  <Navigation
    client:load
    links={navLinks}
    ctaLabel="Solicitar evaluación"
    ctaHref={CONTACT_HREF}
  />

  <main>
    <Hero
      title="Asesoría Especializada en Regulación Sanitaria para Empresas del Sector Salud y Alimenticio"
      paragraph="Protege la operación de tu empresa con el respaldo de especialistas en regulación sanitaria. Asesoramos a organizaciones del sector salud y alimenticio en procesos ante COFEPRIS, cumplimiento de Normas Oficiales Mexicanas (NOM), permisos, licencias, verificaciones sanitarias y procedimientos administrativos."
      indicators={heroIndicators}
      ctaLabel="Solicitar una evaluación regulatoria"
      ctaHref={CONTACT_HREF}
    />

    <ChallengesGrid
      title="¿Tu empresa enfrenta alguno de estos desafíos?"
      ctaLabel="Hablar con un especialista"
      ctaHref={CONTACT_HREF}
    />

    <IntroStatement
      title="Especialistas en regulación sanitaria para empresas que no pueden detener su operación"
      paragraph="Una observación de la autoridad, un incumplimiento normativo o una gestión regulatoria pendiente pueden afectar la continuidad de una empresa. Law & Health desarrolla estrategias para prevenir riesgos, atender procedimientos ante COFEPRIS y fortalecer el cumplimiento sanitario con un enfoque legal y técnico."
    />

    <FeatureGrid
      id="servicios"
      eyebrow="Qué hacemos"
      title="Servicios especializados"
      features={services}
      theme="dark"
    />

    <FeatureGrid
      id="por-que-elegirnos"
      eyebrow="Diferenciadores"
      title="¿Por qué Law & Health?"
      features={whyChooseUs}
      theme="light"
    />

    <SectorsList title="Sectores que asesoramos" theme="dark" />

    <ProcessScroll title="Nuestro proceso" steps={processSteps} theme="light" />

    <Partnerships partners={clients} theme="dark" />

    <CaseStudies title="Casos de éxito" />

    <FAQ
      client:visible
      title="Preguntas frecuentes"
      items={faqItems}
      theme="dark"
    />

    <FinalCTA
      title="Agenda una evaluación regulatoria"
      paragraph="Conoce el camino regulatorio más adecuado para tu empresa. Comparte tu información y un especialista analizará tu caso para definir la estrategia que mejor responda a tus necesidades."
      theme="light"
    />
  </main>

  <Footer navLinks={navLinks} />
</Layout>
